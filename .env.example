# Server-only. Use values from the same Neon branch; never prefix DATABASE_URL with VITE_.
DATABASE_URL=
NEON_AUTH_BASE_URL=https://your-auth-host.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://your-auth-host.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://japanese.thestone.co.za
PORT=3001

# Public frontend configuration. Setup writes the linked branch's Auth URL alias.
VITE_NEON_AUTH_URL=
# Blank locally uses the Vite /api proxy. Set the deployed Vercel API origin for GitHub Pages builds.
VITE_API_URL=
