# Private setup/admin credentials. Never expose database connection strings in VITE_*.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=https://your-auth-host.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://your-auth-host.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_DATA_API_URL=https://your-endpoint.apirest.region.aws.neon.tech/neondb/rest/v1

# Public HTTPS endpoints only. No separate application server is required.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
